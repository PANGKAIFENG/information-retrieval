# Environment Variables — copy to .env (local) or GitHub Secrets (CI)

# AI API Keys (configure at least one)
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GOOGLE_API_KEY=xxx

# Feishu / Lark incoming webhook (required for daily push to Feishu)
# Get it from: Feishu group → Settings → Group Bot → Add Bot → Custom Bot → copy webhook URL
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# Optional: override the OpenAI-compatible base URL (e.g. proxy or compatible gateway)
# OPENAI_BASE_URL=https://api.openai.com/v1

# GitHub Token (optional but recommended for higher rate limits)
# Without token: 60 requests/hour
# With token: 5000 requests/hour
GITHUB_TOKEN=ghp_xxx

# Apify Token (required for Twitter scraping — disabled by default)
# APIFY_TOKEN=apify_api_xxx
